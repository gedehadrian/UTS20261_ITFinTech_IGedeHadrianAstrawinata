# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (MongoDB Atlas free tier works),
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
# Database name (optional)
MONGODB_DB=web_payment_gateway

# Xendit (use TEST mode keys): Dashboard > Settings > API Keys > Secret key (xnd_development_...)
XENDIT_SECRET_KEY=
# Xendit: Dashboard > Settings > Webhooks > "Webhook verification token"
XENDIT_WEBHOOK_TOKEN=

# Public URL of the app, used for Xendit's redirect after payment (optional;
# derived from the request when empty). e.g. https://your-app.vercel.app
APP_BASE_URL=
