# Copy to .env.local and fill in. Never commit .env.local.

# MongoDB connection string (MongoDB Atlas free tier works),
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
# Database name (optional)
MONGODB_DB=web_payment_gateway

# Xendit (use TEST mode keys): Dashboard > Settings > API Keys > Secret key (xnd_development_...)
XENDIT_SECRET_KEY=
# Xendit: Dashboard > Settings > Webhooks > "Webhook verification token"
XENDIT_WEBHOOK_TOKEN=

# PayPal (optional second gateway, SANDBOX): developer.paypal.com > Apps & Credentials > your sandbox app.
# Leave empty to hide PayPal at checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (subscribe to PAYMENT.CAPTURE.COMPLETED)
PAYPAL_WEBHOOK_ID=
# Rupiah per 1 USD used to price PayPal orders (PayPal can't charge IDR). Default 16500.
PAYPAL_IDR_PER_USD=16500

# Public URL of the app, used for the gateways' redirect after payment (optional;
# derived from the request when empty). e.g. https://your-app.vercel.app
APP_BASE_URL=
